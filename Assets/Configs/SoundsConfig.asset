  _: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u044C \u0430\u0443\u0434\u0438\u043E\u043A\u043B\u0438\u043F
    \u0432 \u043F\u043E\u043B\u0435 Clip. \u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u043F\u043B\u0435\u0439\u043C\u043E\u0434 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0437\u0432\u0443\u043A \u0432 \u0438\u0433\u0440\u0435. \u041F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u0431\u043E\u0440\u0430
    \u0437\u0432\u0443\u043A\u043E\u0432 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438
    \u0430\u0443\u0434\u0438\u043E \u043A\u043B\u0438\u043F\u044B \u0432 Addressables.SFX
    \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C AudioService._isDebugPlayNoAsync"
  IsUseSoundsConfig: 1
