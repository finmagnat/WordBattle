    m_Localized: "\u0422\u0438 \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0448 \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0443
      \u0433\u0440\u0443.\n\n\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043F\u043E\u0442\u043E\u0447\u043D\u0443
      \u0433\u0440\u0443, \u0449\u043E\u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
