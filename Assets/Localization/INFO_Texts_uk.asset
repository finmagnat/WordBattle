  m_TableData:
  - m_Id: 166060244992
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0433\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 502774775808
    m_Localized: "  <size=150%><voffset=20><sprite name=\"book\"></voffset></size><size=130%><color=#FF9A00><b>\u042F\u043A
      \u0433\u0440\u0430\u0442\u0438</b></color></size>\r\n<line-height=100%>\r\n1.
      \u0423 \u0446\u0435\u043D\u0442\u0440\u0456 \u043F\u043E\u043B\u044F \u0432\u0436\u0435
      \u0454 \u0441\u043B\u043E\u0432\u043E.\r\n\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430
      \u2014 <b>\u0434\u043E\u0434\u0430\u0442\u0438 \u043E\u0434\u043D\u0443 \u043B\u0456\u0442\u0435\u0440\u0443</b>
      \u0456 \u0441\u043A\u043B\u0430\u0441\u0442\u0438 \u043D\u043E\u0432\u0435
      \u0441\u043B\u043E\u0432\u043E.\r\n\r\n2. \u0417\u0440\u043E\u0431\u0438 \u0445\u0456\u0434:\r\n\u2022
      \u043E\u0431\u0435\u0440\u0438 \u043F\u043E\u0440\u043E\u0436\u043D\u044E \u043A\u043B\u0456\u0442\u0438\u043D\u043A\u0443
      \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u043B\u0456\u0442\u0435\u0440\u0430\u043C\u0438 
      \r\n\u2022 \u043E\u0431\u0435\u0440\u0438 \u043B\u0456\u0442\u0435\u0440\u0443 
      \r\n\u2022 \u0441\u043A\u043B\u0430\u0434\u0438 \u0441\u043B\u043E\u0432\u043E
      <i>(\u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0447\u0438 \u043D\u043E\u0432\u0443
      \u043B\u0456\u0442\u0435\u0440\u0443)</i>  \r\n\u2022 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      <b>\xAB\u0417\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438\xBB</b>\r\n</line-height>\r\n<line-height=100%>\r\n 
      <size=150%><voffset=20><sprite name=\"gear\"></voffset></size><size=130%><color=#FF9A00><b>\u041F\u0440\u0430\u0432\u0438\u043B\u0430</b></color></size>\r\n\r\n\u2022
      \u0421\u043B\u043E\u0432\u0430 \u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044E\u044E\u0442\u044C\u0441\u044F
      \u0432 \u043E\u0434\u043D\u043E\u043C\u0443 \u0440\u0430\u0443\u043D\u0434\u0456 
      \r\n\u2022 \u0421\u043B\u043E\u0432\u0430 \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F
      <b>\u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0456
      \u0430\u0431\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0456</b> 
      \r\n  <size=85%><color=#AAAAAA>(\u0431\u0435\u0437 \u0434\u0456\u0430\u0433\u043E\u043D\u0430\u043B\u0435\u0439)</color></size> 
      \r\n\u2022 \u041D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0431\u0440\u0430\u0442\u0438
      \u043E\u0434\u043D\u0443 \u043A\u043B\u0456\u0442\u0438\u043D\u043A\u0443 \u0434\u0432\u0456\u0447\u0456,
      \u043A\u043E\u043B\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u0448 \u0441\u043B\u043E\u0432\u043E\r\n\u2022
      <b>1 \u043B\u0456\u0442\u0435\u0440\u0430 = 1 \u043E\u0447\u043A\u043E</b>\r\n\u2022
      \u0427\u0430\u0441 \u043D\u0430 \u0445\u0456\u0434 \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u0438\u0439\r\n</line-height>\r\n<line-height=100%>\r\n 
      <size=150%><voffset=20><sprite name=\"time\"></voffset></size><size=130%><color=#FF9A00><b>\u041D\u0435
      \u0432\u0441\u0442\u0438\u0433</b></color></size>\r\n\r\n\u2022 \u0425\u0456\u0434
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0454\u0442\u044C\u0441\u044F 
      \r\n</line-height>\r\n<line-height=100%>\r\n  <size=150%><voffset=20><sprite
      name=\"finish\"></voffset></size><size=130%><color=#FF9A00><b>\u041A\u0456\u043D\u0435\u0446\u044C
      \u0440\u0430\u0443\u043D\u0434\u0443</b></color></size>\r\n\r\n\u2022 \u0420\u0430\u0443\u043D\u0434
      \u0437\u0430\u043A\u0456\u043D\u0447\u0443\u0454\u0442\u044C\u0441\u044F, \u043A\u043E\u043B\u0438
      \u043F\u043E\u043B\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0435 
      \r\n\u2022 \u041F\u0435\u0440\u0435\u043C\u0430\u0433\u0430\u0454 \u0433\u0440\u0430\u0432\u0435\u0446\u044C
      \u0456\u0437 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u043E\u044E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044E
      \u043E\u0447\u043E\u043A  \r\n\u2022 \u042F\u043A\u0449\u043E \u0440\u0430\u0445\u0443\u043D\u043E\u043A
      \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u0438\u0439 \u2014 <b>\u043D\u0456\u0447\u0438\u044F</b>\r\n</line-height>"
    m_Metadata:
      m_Items: []
  - m_Id: 20447734677504
    m_Localized: " <size=150%><voffset=20><sprite name=\"question\"></voffset></size>\u0417\u0430\u043F\u0438\u0442\u0430\u043D\u043D\u044F
      \u0442\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 20937088319488
    m_Localized: "<line-height=100%>\r\n<b>\u042F\u043A \u0432\u0438\u0434\u0430\u043B\u0438\u0442\u0438
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0443 \u043B\u0456\u0442\u0435\u0440\u0443
      \u0430\u0431\u043E \u0437\u043D\u044F\u0442\u0438 \u0432\u0438\u0434\u0456\u043B\u0435\u043D\u043D\u044F?</b> 
      \r\n\u2014 \u041D\u0430\u0442\u0438\u0441\u043D\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
      <b>\xAB\u0421\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438\xBB</b>.\r\n\r\n<b>\u042F\u043A
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0433\u0440\u0443 \u043D\u0430
      \u043F\u0430\u0443\u0437\u0443?</b>  \r\n\u2014 \u041D\u0430\u0442\u0438\u0441\u043D\u0438
      \u043A\u043D\u043E\u043F\u043A\u0443 <b>\xAB\u041F\u0430\u0443\u0437\u0430\xBB</b>.
      \u0422\u0430\u0439\u043C\u0435\u0440 \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u044C\u0441\u044F,
      \u0430 \u043B\u0456\u0442\u0435\u0440\u0438 \u043D\u0430 \u043F\u043E\u043B\u0456
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u0437\u043D\u0438\u043A\u043D\u0443\u0442\u044C. 
      \r\n\u2014 \u0429\u043E\u0431 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
      \u0433\u0440\u0443, \u043D\u0430\u0442\u0438\u0441\u043D\u0438 <b>\xAB\u041F\u0430\u0443\u0437\u0430\xBB</b>
      \u0449\u0435 \u0440\u0430\u0437.\r\n\r\n<b>\u042F\u043A \u0432\u0438\u0439\u0442\u0438
      \u0437 \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E\u0457
      \u0433\u0440\u0438?</b>  \r\n\u2014 \u041D\u0430\u0442\u0438\u0441\u043D\u0438
      \u043A\u043D\u043E\u043F\u043A\u0443 <b>\xAB\u0414\u043E\u0434\u043E\u043C\u0443\xBB</b>. 
      \r\n\u2014 \u0423 \u0440\u0435\u0436\u0438\u043C\u0456 \u0433\u0440\u0438 \u0437
      \u0406\u0406 \u0437\u2019\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u0432\u0456\u043A\u043D\u043E
      \u0437 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0454\u044E \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
      \u0433\u0440\u0443.  \r\n\u2014 \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0443
      \u0433\u0440\u0443 \u043C\u043E\u0436\u043D\u0430 \u043F\u0456\u0437\u043D\u0456\u0448\u0435
      \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438 \u0442\u0430
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0437 \u0442\u043E\u0433\u043E
      \u0436 \u043C\u0456\u0441\u0446\u044F.\r\n\r\n  <size=150%><voffset=20><sprite
      name=\"shop\"></voffset></size><b>\u042F\u043A \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0431\u0443\u0441\u0442\u0435\u0440\u0438?</b>  \r\n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440\u0438
      \u043C\u043E\u0436\u043D\u0430 \u043A\u0443\u043F\u0438\u0442\u0438 \u0432
      \u0456\u0433\u0440\u043E\u0432\u043E\u043C\u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456
      \u0437\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u0456 \u0433\u0440\u043E\u0448\u0456. 
      \r\n\u2014 \u0422\u0430\u043A\u043E\u0436 \u0457\u0445 \u043C\u043E\u0436\u043D\u0430
      \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0437\u0430 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434
      \u0440\u0435\u043A\u043B\u0430\u043C\u0438.\r\n</line-height>"
    m_Metadata:
      m_Items: []
  - m_Id: 50729208740462592
    m_Localized: " <size=150%><voffset=20><sprite name=\"info\"></voffset></size>\u0411\u0443\u0441\u0442\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 50729394833342464
    m_Localized: "<line-height=100%>\r\n  <size=150%><voffset=20><sprite name=\"letter\"></voffset></size><b>\xAB\u0411\u0443\u043A\u0432\u0430\xBB
      \u2014 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0437\u043D\u0430\u0439\u0442\u0438
      \u043D\u043E\u0432\u0435 \u0441\u043B\u043E\u0432\u043E</b>\r\n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u0437\u043D\u0430\u0439\u0434\u0435
      \u0441\u043B\u043E\u0432\u043E <i>(\u0437\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
      \u043D\u0430\u0439\u0434\u043E\u0432\u0448\u0435)</i>, \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043B\u0456\u0442\u0435\u0440\u0443 \u043D\u0430 \u043F\u043E\u043B\u0435
      \u0442\u0430 \u0432\u0438\u0434\u0456\u043B\u0438\u0442\u044C \u0446\u0435
      \u0441\u043B\u043E\u0432\u043E.  \r\n\u2014 \u042F\u043A\u0449\u043E \u0441\u043B\u043E\u0432\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u043E, \u0431\u0443\u0441\u0442\u0435\u0440
      \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u0442\u044C\u0441\u044F \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440.\r\n\r\n 
      <size=150%><voffset=20><sprite name=\"slowdown\"></voffset></size><b>\xAB\u0423\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043D\u044F\xBB
      \u2014 \u0434\u0430\u0441\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u0435
      \u0447\u0430\u0441\u0443 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438</b> 
      \r\n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440 \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u044C
      \u0442\u0430\u0439\u043C\u0435\u0440 \u043D\u0430 \u043F\u0435\u0432\u043D\u0438\u0439
      \u0447\u0430\u0441 <i>(30 \u0441\u0435\u043A\u0443\u043D\u0434)</i>, \u0434\u0430\u044E\u0447\u0438
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0447\u0430\u0441\u0443 \u043D\u0430
      \u0445\u0456\u0434.\r\n\r\n  <size=150%><voffset=20><sprite name=\"eraser\"></voffset></size><b>\xAB\u0413\u0443\u043C\u043A\u0430\xBB
      \u2014 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u0438
      \u043F\u043E\u043B\u0435</b>   \r\n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440
      \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u0441\u0442\u0435\u0440\u0442\u0438
      \u043D\u0430 \u043F\u043E\u043B\u0456 <i>\u043E\u0434\u043D\u0443 \u043B\u0456\u0442\u0435\u0440\u0443
      \u0437\u0430 \u043E\u0434\u0438\u043D \u0445\u0456\u0434</i>, \u0430 \u043D\u0430
      \u0457\u0457 \u043C\u0456\u0441\u0446\u0435 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438 \u0456\u043D\u0448\u0443.\r\n\r\n 
      <size=150%><voffset=20><sprite name=\"swap\"></voffset></size><b>\xAB\u041C\u0456\u043D\u044F\u043B\u043A\u0430\xBB
      \u2014 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043F\u0456\u0434\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438
      \u043F\u043E\u043B\u0435 \u043F\u0456\u0434 \u0441\u0435\u0431\u0435</b>  
      \r\n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440 \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454
      \u043F\u043E\u043C\u0456\u043D\u044F\u0442\u0438 \u043C\u0456\u0441\u0446\u044F\u043C\u0438
      2 \u043B\u0456\u0442\u0435\u0440\u0438 \u043D\u0430 \u043F\u043E\u043B\u0456.\r\n\r\n 
      <size=150%><voffset=20><sprite name=\"mixer\"></voffset></size><b>\xAB\u041C\u0456\u043A\u0441\u0435\u0440\xBB
      \u2014 \u0437\u043C\u0456\u043D\u0438\u0442\u044C \u043F\u043E\u043B\u0435
      \u0442\u0430 \u0434\u0430\u0441\u0442\u044C \u043D\u043E\u0432\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456</b>  
      \r\n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440 \u043F\u0435\u0440\u0435\u043C\u0456\u0448\u0430\u0454
      \u043B\u0456\u0442\u0435\u0440\u0438 \u0442\u0430 \u0440\u043E\u0437\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0457\u0445 \u0443 \u043D\u0435\u0437\u0432\u0438\u0447\u043D\u043E\u043C\u0443
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u043D\u0430 \u043F\u043E\u043B\u0456.\r\n</line-height>"
    m_Metadata:
      m_Items: []
  - m_Id: 50754050877440000
    m_Localized: "<line-height=100%>\r\n  <size=200%><voffset=20><sprite name=\"letter\"></voffset></size><b>\xAB\u0411\u0443\u043A\u0432\u0430\xBB</b>
      \u2014 \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u0437\u043D\u0430\u0439\u0442\u0438
      \u043D\u043E\u0432\u0435 \u0441\u043B\u043E\u0432\u043E\r\n\r\n  <size=200%><voffset=20><sprite
      name=\"slowdown\"></voffset></size><b>\xAB\u0423\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0435\u043D\u043D\u044F\xBB</b>
      \u2014 \u0434\u0430\u0441\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u0435
      \u0447\u0430\u0441\u0443 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438\r\n\r\n 
