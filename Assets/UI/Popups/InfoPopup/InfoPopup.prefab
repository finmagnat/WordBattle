--- !u!1001 &912720991336356534
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 4687579492425599830}
    m_Modifications:
    - target: {fileID: 171911757322616017, guid: 8e311f3d45f93334195937bf693855ee, type: 3}
      propertyPath: localizedString.m_TableEntryReference.m_KeyId
      value: 20937088319488
      objectReference: {fileID: 0}
    - target: {fileID: 171911757322616017, guid: 8e311f3d45f93334195937bf693855ee, type: 3}
      propertyPath: localizedString.m_TableReference.m_TableCollectionName
      value: GUID:50d4f8a5b29ff6c4d81e6cf9c447f908
      objectReference: {fileID: 0}
    - target: {fileID: 676827338453965669, guid: 8e311f3d45f93334195937bf693855ee, type: 3}
      propertyPath: m_text
      value: "<line-height=100%>\n<b>\u041A\u0430\u043A \u0443\u0434\u0430\u043B\u0438\u0442\u044C
        \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
        \u0431\u0443\u043A\u0432\u0443 \u0438\u043B\u0438 \u0441\u043D\u044F\u0442\u044C
        \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0435?</b>  \n\u2014 \u041D\u0430\u0436\u043C\u0438
        \u043A\u043D\u043E\u043F\u043A\u0443 <b>\xAB\u041E\u0442\u043C\u0435\u043D\u0430\xBB</b>.\n\n<b>\u041A\u0430\u043A
        \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438\u0433\u0440\u0443
        \u043D\u0430 \u043F\u0430\u0443\u0437\u0443?</b>  \n\u2014 \u041D\u0430\u0436\u043C\u0438
        \u043A\u043D\u043E\u043F\u043A\u0443 <b>\xAB\u041F\u0430\u0443\u0437\u0430\xBB</b>.
        \u0422\u0430\u0439\u043C\u0435\u0440 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F,
        \u0430 \u0431\u0443\u043A\u0432\u044B \u043D\u0430 \u043F\u043E\u043B\u0435
        \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0441\u043A\u0440\u043E\u044E\u0442\u0441\u044F. 
        \n\u2014 \u0427\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
        \u0438\u0433\u0440\u0443, \u043D\u0430\u0436\u043C\u0438 <b>\xAB\u041F\u0430\u0443\u0437\u0430\xBB</b>
        \u0435\u0449\u0451 \u0440\u0430\u0437.\n\n<b>\u041A\u0430\u043A \u0432\u044B\u0439\u0442\u0438
        \u0438\u0437 \u043D\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u043E\u0439
        \u0438\u0433\u0440\u044B?</b>  \n\u2014 \u041D\u0430\u0436\u043C\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
        <b>\xAB\u0414\u043E\u043C\u043E\u0439\xBB</b>.  \n\u2014 \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
        \u0438\u0433\u0440\u044B \u0441 \u0418\u0418 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
        \u043E\u043A\u043D\u043E \u0441 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
        \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0438\u0433\u0440\u0443. 
        \n\u2014 \u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u0443\u044E
        \u0438\u0433\u0440\u0443 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0437\u0436\u0435
        \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
        \u0441 \u0442\u043E\u0433\u043E \u0436\u0435 \u043C\u0435\u0441\u0442\u0430.
        \n\n  <size=150%><voffset=20><sprite name=\"shop\"></voffset></size><b>\u041A\u0430\u043A
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0431\u0443\u0441\u0442\u0435\u0440\u044B?</b> 
        \n\u2014 \u0411\u0443\u0441\u0442\u0435\u0440\u044B \u043C\u043E\u0436\u043D\u043E
        \u043A\u0443\u043F\u0438\u0442\u044C \u0432 \u0438\u0433\u0440\u043E\u0432\u043E\u043C
        \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u0437\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
        \u0434\u0435\u043D\u044C\u0433\u0438.  \n\u2014 \u0422\u0430\u043A\u0436\u0435
        \u0438\u0445 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
        \u0437\u0430 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u0440\u0435\u043A\u043B\u0430\u043C\u044B.\n\n 
        <size=150%><voffset=20><sprite name=\"shop\"></voffset></size><b>\u041A\u0430\u043A
        \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u0443?</b>\n\u2014
        \u0420\u0435\u043A\u043B\u0430\u043C\u0443 \u043C\u0435\u0436\u0434\u0443
        \u044D\u043A\u0440\u0430\u043D\u0430\u043C\u0438 \u043C\u043E\u0436\u043D\u043E
        \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432 \u0438\u0433\u0440\u043E\u0432\u043E\u043C
        \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435.\n\u2014 \u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440
        \u0440\u0435\u043A\u043B\u0430\u043C\u044B \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
        \u0431\u0443\u0441\u0442\u0435\u0440\u043E\u0432 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
        \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D.\n</line-height>"
      objectReference: {fileID: 0}
